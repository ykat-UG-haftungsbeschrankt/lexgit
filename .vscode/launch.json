{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run and debug app",
			"type": "pwa-chrome",
			"request": "launch",
			"url": "http://localhost:5173/",
			"webRoot": "${workspaceFolder}",
			"preLaunchTask": "Run app",
			"sourceMaps": true
		},
		{
			"name": "Debug app (server already running)",
			"type": "pwa-chrome",
			"request": "launch",
			"url": "http://localhost:5173/",
			"webRoot": "${workspaceFolder}",
			"sourceMaps": true
		},
		{
			"name": "Debug Vite server and law API",
			"type": "node",
			"request": "launch",
			"program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
			"args": [
				"--host",
				"127.0.0.1",
				"--port",
				"5173",
				"--strictPort",
				"--configLoader",
				"runner"
			],
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"sourceMaps": true,
			"skipFiles": [
				"<node_internals>/**"
			]
		}
	]
}
